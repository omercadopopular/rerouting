# Ignore all data files except specific analysis configs
data/raw/*
data/fajgelbaum/*
data/staging/*
data/verification/*
data/analysis/*
data/reference/*
data/rerouted_shares/*
data/processed/*

# Project-local build tools and archived generated replication outputs
.tools/
archive/replication/*
!archive/replication/README.md
!archive/replication/archive_manifest.json

# Ignore large data files in root data/
data/*.dta
data/*.csv
data/*.parquet

# Ignore Python cache files
.venv/
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd
.Python

# Ignore local browser drivers and browser profiles used by policy-source downloads
data/selenium-drive/

# Ignore output figures (PNGs - keep PDFs for publication)
*.png
